# .gitignore for AI Fitness Pose Detection

# Node modules
node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
Thumbs.db
.DS_Store

# Temporary files
*.tmp
*.temp

# Build outputs (if any)
dist/
build/

# Environment variables
.env
.env.local
.env.production

# Test coverage
coverage/

# Package manager files
package-lock.json
yarn.lock
pnpm-lock.yaml
